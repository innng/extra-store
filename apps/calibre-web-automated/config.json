{
  "$schema": "../app-info-schema.json",
  "id": "calibre-web-automated",
  "name": "Calibre-Web Automated",
  "version": "0.6.27",
  "description": "Calibre-Web with universal-calibre mod for PDF→EPUB conversion. Based on linuxserver/calibre-web with docker-mods.",
  "short_desc": "Automated Calibre-Web with conversions",
  "author": "linuxserver.io",
  "source": "https://github.com/janeczku/calibre-web",
  "website": "https://github.com/janeczku/calibre-web",
  "available": true,
  "exposable": true,
  "port": 8083,
  "tipi_version": 64,
  "categories": ["media", "books"],
  "requirements": {
    "ports": [8083]
  },
  "form_fields": [
    {
      "type": "text",
      "label": "External Hostname",
      "description": "Public hostname for Traefik routing (e.g., books.yourdomain.com)",
      "env_variable": "APP_HOST",
      "required": true
    },
    {
      "type": "text",
      "label": "Docker Mods",
      "description": "universal-calibre for conversions",
      "env_variable": "DOCKER_MODS",
      "default": "linuxserver/mods:universal-calibre",
      "required": true
    }
  ],
  "supported_architectures": ["amd64", "arm64"],
  "dynamic_config": true,
  "min_tipi_version": "4.7.0"
}